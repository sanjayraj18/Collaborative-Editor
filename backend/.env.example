
APP_ENV=dev
# Must be >= 32 bytes: python -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-me

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth (Phase 1)
TICKET_TTL_SECONDS=30

# Login abuse control (Phase 0)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
RATE_LIMIT_FAIL_OPEN=true

# JWT / sessions
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30

# Liveness (Phase 4)
PING_INTERVAL_SECONDS=20
PONG_TIMEOUT_SECONDS=45

# Backpressure (Phase 2)
MAX_FRAME_BYTES=1048576
SEND_QUEUE_MAX_FRAMES=256
SEND_QUEUE_MAX_BYTES=8388608

# Rooms (Phase 3) and resume (Phase 8)
ROOM_INBOX_MAX_FRAMES=1024
ROOM_IDLE_TTL_SECONDS=60
REAPER_INTERVAL_SECONDS=10
PERMISSION_CHECK_SECONDS=30
RESUME_RING_SIZE=1024

UPDATE_COALESCE_MS=20
AWARENESS_COALESCE_MS=100

DATABASE_URL=postgresql://collab:collab@localhost:5432/collab
REDIS_URL=redis://localhost:6379/0